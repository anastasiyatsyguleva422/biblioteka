<Page x:Class="biblioteka.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:biblioteka"
      mc:Ignorable="d" 
      Title="ReportPage" Background="White"
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <ScrollViewer>
            <StackPanel>
            <TextBlock Text="Отчет по выдачам и возвратам" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <DataGrid x:Name="ReportDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="300" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Студент" Binding="{Binding Студент}" Width="*"/>
                    <DataGridTextColumn Header="Книга" Binding="{Binding Книга}" Width="*"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding Дата_Выдачи}" Width="120"/>
                    <DataGridTextColumn Header="Срок возврата" Binding="{Binding Срок_Возврата}" Width="120"/>
                    <DataGridTextColumn Header="Дата возврата" Binding="{Binding Дата_Возврата}" Width="120"/>
                    <DataGridTextColumn Header="Состояние книги" Binding="{Binding Состояние}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
                       <Button Content="Назад" Click="GoBack_Click" FontSize="16" Padding="10" HorizontalAlignment="Center" Width="150"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>