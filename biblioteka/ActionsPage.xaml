<Page x:Class="biblioteka.ActionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ActionsPage" Background="White">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="Выберите действие" 
                       Style="{StaticResource TitleText}" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <Button Content="Выдача книг" Click="GoToVidacha_Click"
                    Style="{StaticResource {x:Type Button}}"
                    FontSize="18" Padding="15" Width="280" />

            <Button Content="Возврат книг" Click="GoToVozvrat_Click"
                    Style="{StaticResource {x:Type Button}}"
                    FontSize="18" Padding="15" Width="280" />

            <Button Content="Архив книг" Click="GoToArxiv_Click"
                    Style="{StaticResource {x:Type Button}}"
                    FontSize="18" Padding="15" Width="280" />

            <Button Content="Отчет по выдачам" Click="GoToReport_Click"
                    Style="{StaticResource {x:Type Button}}"
                    FontSize="18" Padding="15" Width="280" Margin="0"/>
        </StackPanel>
    </Grid>
</Page>
