<Page x:Class="biblioteka.VozvratPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:biblioteka"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VozvratPage" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Возврат книг" Style="{StaticResource TitleText}" />

        <StackPanel Grid.Row="1" Orientation="Vertical" Width="400" HorizontalAlignment="Center">
            <Label Content="Выберите выдачу для возврата:" />
            <ComboBox x:Name="IssueComboBox" DisplayMemberPath="Описание" SelectedValuePath="ID_Выдачи" />

            <Label Content="Состояние книги:" />
            <TextBox x:Name="BookConditionTextBox" />

            <Button Content="Оформить возврат" Click="Vozvrat_Click" />
            <Button Content="Назад" Margin="5" Click="GoBack_Click"/>
            
        </StackPanel>
    </Grid>
</Page>
