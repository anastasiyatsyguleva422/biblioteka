<Page x:Class="biblioteka.ArxivPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:biblioteka"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditBookPage" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Редактирование книг" Style="{StaticResource TitleText}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Width="400" HorizontalAlignment="Center">
                <Label Content="Выберите книгу:" />
                <ComboBox x:Name="BookComboBox" DisplayMemberPath="Название" SelectedValuePath="ID_Книги" SelectionChanged="BookComboBox_SelectionChanged"/>

                <Label Content="Название книги:" />
                <TextBox x:Name="TitleTextBox" />

                <Label Content="Автор (ФИО):" />
                <TextBox x:Name="AuthorTextBox" />

                <Label Content="Страна автора:" />
                <TextBox x:Name="CountryTextBox" />

                <Label Content="Жанр:" />
                <TextBox x:Name="GenreTextBox" />

                <Label Content="Год издания:" />
                <ComboBox x:Name="YearComboBox" />

                <Label Content="Количество экземпляров:" />
                <TextBox x:Name="QuantityTextBox" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Сохранить изменения" Click="SaveButton_Click" Margin="5"/>
                    <Button Content="Назад" Click="GoBack_Click" Margin="5"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
